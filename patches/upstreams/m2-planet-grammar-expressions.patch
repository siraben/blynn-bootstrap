+void logical_and_expr(void)
+{
+	bitwise_expr();
+	while(match("&&", global_token->s))
+	{
+		char* number_string = int2str(current_count, 10, TRUE);
+		current_count = current_count + 1;
+		char* unique_id = create_unique_id("", function->s, number_string);
+		emit_jump_if_zero(REGISTER_ZERO, "AND_FALSE_", unique_id, "short circuit and");
+		require_extra_token();
+		bitwise_expr();
+		emit_jump_if_zero(REGISTER_ZERO, "AND_FALSE_", unique_id, "logical and rhs");
+		emit_load_immediate(REGISTER_ZERO, 1, "logical true");
+		emit_unconditional_jump("AND_END_", unique_id, "logical and end");
+		emit_label("AND_FALSE_", unique_id);
+		emit_load_immediate(REGISTER_ZERO, 0, "logical false");
+		emit_label("AND_END_", unique_id);
+		current_target = integer;
+	}
+}
